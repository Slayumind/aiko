# Code style for Aiko. Directory.Build.props turns on EnforceCodeStyleInBuild, which without this
# file only ever checked the compiler's own defaults.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,slnx,xaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.cs]
max_line_length = 110

# Usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# Namespaces and braces
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning

# Say the type when it is not obvious from the right hand side.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Modern C# the project already uses everywhere.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:warning
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# Names. The order matters: the first rule that matches a symbol wins, so the narrow ones go
# first. Constants and static fields are PascalCase whatever their accessibility, and only a
# private instance field takes the underscore.
dotnet_naming_rule.constants_are_pascal.severity = warning
dotnet_naming_rule.constants_are_pascal.symbols = constants
dotnet_naming_rule.constants_are_pascal.style = pascal
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.static_fields_are_pascal.severity = warning
dotnet_naming_rule.static_fields_are_pascal.symbols = static_fields
dotnet_naming_rule.static_fields_are_pascal.style = pascal
dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.required_modifiers = static

dotnet_naming_rule.private_fields_with_underscore.severity = warning
dotnet_naming_rule.private_fields_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_with_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# An unused parameter or a needless assignment is usually a mistake, not a style.
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0060.severity = suggestion

# Generated by CsWin32, not ours to style.
[**/obj/**.cs]
generated_code = true
