<!--
  The card is a window of its own: no frame, see through background, above other windows and
  never taking the focus. It is created when it is needed and closed, not hidden.
-->
<Window x:Class="Aiko.App.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aiko.App"
        Title="Aiko"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight">

  <local:CardPanel x:Name="Panel" />
</Window>
