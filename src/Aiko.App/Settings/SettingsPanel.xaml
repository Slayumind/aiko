<UserControl x:Class="Aiko.App.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aiko.App">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Theme/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <!--
    The settings stand in the terminal window on the place of the list and the terminal (D-374): the
    menu on the left with each environment and the sections, the chosen page on the right.
  -->
  <Grid x:Name="Body" Background="{StaticResource Surface}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="NavColumn" Width="188" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel Margin="8,12,8,10">
      <TextBlock x:Name="VersionLine" DockPanel.Dock="Bottom" Style="{StaticResource RowNote}" Margin="10,8,0,0" />
      <StackPanel x:Name="Nav" />
    </DockPanel>
    <Border x:Name="NavLine" Width="1" HorizontalAlignment="Right" Background="{StaticResource Hairline}" />

    <ScrollViewer x:Name="PageScroll" Grid.Column="1" Style="{StaticResource QuietScroll}">
      <ContentControl x:Name="PageHost" Margin="20,18,20,20" Focusable="False" />
    </ScrollViewer>
    <local:SavedMark x:Name="Saved" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,23,24,0" />
  </Grid>
</UserControl>
