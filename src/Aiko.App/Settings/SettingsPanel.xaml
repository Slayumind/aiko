<UserControl x:Class="Aiko.App.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aiko.App">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Theme/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate x:Key="EnvironmentTemplate" DataType="{x:Type local:EnvironmentLine}">
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="{Binding Name}" Style="{StaticResource RowName}" />
            <TextBlock Text="{Binding Folders}" Style="{StaticResource RowNote}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <TextBlock Text="direct" Style="{StaticResource RowNote}" VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding DirectMode}"
                          Checked="OnDirectModeChanged" Unchecked="OnDirectModeChanged"
                          Tag="{Binding Name}" />
          </StackPanel>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Margin="20">
    <Border Width="360"
            Background="{StaticResource Surface}"
            CornerRadius="{StaticResource CardRadius}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="1"
            Effect="{StaticResource CardShadow}">
      <StackPanel Margin="{StaticResource CardPad}">

        <Grid x:Name="HeaderRow">
          <TextBlock Text="Settings" VerticalAlignment="Center"
                     FontFamily="{StaticResource Sans}" FontSize="{StaticResource TextName}"
                     FontWeight="Medium" Foreground="{StaticResource Ink}" />
          <Button HorizontalAlignment="Right" Click="OnClose" ToolTip="Close"
                  Width="22" Height="22" Background="Transparent" Cursor="Hand">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="6">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Back" Property="Background" Value="{StaticResource Raised}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{StaticResource Muted}"
                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="10" Height="10" />
          </Button>
        </Grid>

        <TextBlock Text="ENVIRONMENTS" Style="{StaticResource SectionLabel}" />
        <ItemsControl x:Name="Environments" ItemTemplate="{StaticResource EnvironmentTemplate}" />
        <TextBlock x:Name="NoEnvironments" Text="No environments yet. Aiko finds them on the first run."
                   Style="{StaticResource RowHint}" Visibility="Collapsed" />

        <TextBlock Text="WHERE TO SHOW" Style="{StaticResource SectionLabel}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <RadioButton x:Name="PlaceTray" Grid.Column="0" Style="{StaticResource PlaceCard}"
                       GroupName="Place" Checked="OnPlaceChanged">
            <StackPanel>
              <!-- A screen with a dot down by the clock. -->
              <Border Height="46" CornerRadius="4" Background="{StaticResource Background}"
                      BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                <Grid VerticalAlignment="Bottom">
                  <Border Height="8" Background="{StaticResource Raised}" />
                  <Ellipse Width="5" Height="5" Fill="{StaticResource Positive}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                </Grid>
              </Border>
              <TextBlock Text="Tray" Style="{StaticResource RowName}" Margin="0,8,0,0"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </RadioButton>

          <RadioButton x:Name="PlaceIsland" Grid.Column="2" Style="{StaticResource PlaceCard}"
                       GroupName="Place" Checked="OnPlaceChanged">
            <StackPanel>
              <!-- The same screen with a small island at the top. -->
              <Border Height="46" CornerRadius="4" Background="{StaticResource Background}"
                      BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                <Border Width="38" Height="9" CornerRadius="0,0,5,5" Background="{StaticResource Raised}"
                        HorizontalAlignment="Center" VerticalAlignment="Top" />
              </Border>
              <TextBlock Text="Island" Style="{StaticResource RowName}" Margin="0,8,0,0"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </RadioButton>
        </Grid>

        <!-- Only worth showing when Aiko lives in the island; in the tray it changes nothing. -->
        <Grid x:Name="IslandOnly" Margin="0,12,0,0">
          <TextBlock Text="Hide the island in full screen" Style="{StaticResource RowName}" />
          <ToggleButton x:Name="HideInFullScreen" Style="{StaticResource Switch}"
                        HorizontalAlignment="Right" Checked="OnHideChanged" Unchecked="OnHideChanged" />
        </Grid>

        <TextBlock Text="STARTUP AND UPDATES" Style="{StaticResource SectionLabel}" />
        <Grid Margin="0,0,0,10">
          <TextBlock Text="Start with Windows" Style="{StaticResource RowName}" />
          <ToggleButton x:Name="RunAtStartup" Style="{StaticResource Switch}"
                        HorizontalAlignment="Right" Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Check for updates" Style="{StaticResource RowName}" />
            <TextBlock Text="Asks slayumind.org, downloads come from GitHub"
                       Style="{StaticResource RowNote}" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleButton x:Name="CheckUpdates" Grid.Column="1" Style="{StaticResource Switch}"
                        VerticalAlignment="Center"
                        Checked="OnUpdatesChanged" Unchecked="OnUpdatesChanged" />
        </Grid>

        <StackPanel Margin="0,10,0,0">
          <!-- Empty until something has been checked: an empty line would only leave a gap. -->
          <TextBlock x:Name="UpdateLine" Style="{StaticResource RowHint}" Visibility="Collapsed"
                     Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="CheckNow" Content="Check now" Style="{StaticResource QuietButton}"
                    Click="OnCheckNow" />
            <Button x:Name="OpenDownload" Content="Open download page" Style="{StaticResource QuietButton}"
                    Margin="8,0,0,0" Click="OnOpenDownload" Visibility="Collapsed" />
          </StackPanel>
        </StackPanel>

        <TextBlock Text="LANGUAGE" Style="{StaticResource SectionLabel}" />
        <Border Style="{StaticResource SegmentBar}">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="LanguageSystem" Style="{StaticResource Segment}" GroupName="Language"
                         Content="System" Checked="OnLanguageChanged" />
            <RadioButton x:Name="LanguageEnglish" Style="{StaticResource Segment}" GroupName="Language"
                         Content="English" Checked="OnLanguageChanged" />
            <RadioButton x:Name="LanguageRussian" Style="{StaticResource Segment}" GroupName="Language"
                         Content="Русский" Checked="OnLanguageChanged" />
          </StackPanel>
        </Border>

        <Border Height="1" Background="{StaticResource Hairline}" Margin="0,16,0,12" />

        <!-- The two buttons already fill the width at 360, so the version and the address go on
             their own line underneath instead of being cut in half. -->
        <StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Copy diagnostics" Style="{StaticResource QuietButton}" Click="OnCopyDiagnostics" />
            <Button Content="Quit Aiko" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="OnQuit" />
          </StackPanel>
          <TextBlock x:Name="VersionLine" Style="{StaticResource RowNote}" Margin="0,10,0,0" />
        </StackPanel>

      </StackPanel>
    </Border>
  </Grid>
</UserControl>
