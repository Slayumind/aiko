<UserControl x:Class="Aiko.App.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aiko.App">

  <!--
    One settings window (D-177): a menu on the left with each environment, the project folders and
    the general settings, and the chosen page on the right. The window keeps its size while the
    pages change, so nothing under the mouse moves.
  -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Theme/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Margin="20">
    <Border Width="720"
            Background="{StaticResource Surface}"
            CornerRadius="{StaticResource CardRadius}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="1"
            Effect="{StaticResource CardShadow}">
      <DockPanel>
        <Grid x:Name="HeaderRow" DockPanel.Dock="Top" Height="44" Background="Transparent">
          <TextBlock Text="{x:Static local:Strings.Settings}" VerticalAlignment="Center" Margin="16,0,0,0"
                     FontFamily="{StaticResource Sans}" FontSize="{StaticResource TextName}"
                     FontWeight="Medium" Foreground="{StaticResource Ink}" />
          <Button x:Name="CloseButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,10,0"
                  Click="OnClose">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{StaticResource Muted}"
                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" />
          </Button>
          <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Hairline}" />
        </Grid>

        <Grid x:Name="Body" Height="600">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <DockPanel Margin="8,12,8,10">
            <TextBlock x:Name="VersionLine" DockPanel.Dock="Bottom" Style="{StaticResource RowNote}" Margin="10,8,0,0" />
            <StackPanel x:Name="Nav" />
          </DockPanel>
          <Border Width="1" HorizontalAlignment="Right" Background="{StaticResource Hairline}" />

          <ScrollViewer x:Name="PageScroll" Grid.Column="1" Style="{StaticResource QuietScroll}">
            <ContentControl x:Name="PageHost" Margin="20,18,20,20" Focusable="False" />
          </ScrollViewer>
          <local:SavedMark x:Name="Saved" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,23,24,0" />
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
