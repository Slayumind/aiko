<UserControl x:Class="Aiko.App.TerminalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aiko.App">

  <!-- The zoom, the notices and voice input of the terminal (D-313, D-315, D-384, D-396). The size of the model is on the page before
       anything downloads, and the line about OpenAI stands next to the choice, not in the help. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Theme/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Text="{x:Static local:Strings.NavTerminal}" FontFamily="{StaticResource Sans}" FontSize="16"
               FontWeight="Medium" Foreground="{StaticResource Ink}" />

    <!-- The zoom of the terminal window (D-384). The keys are in the hint: they are faster than the page. -->
    <TextBlock Text="{x:Static local:Strings.ZoomLabel}" Style="{StaticResource SectionLabel}" Margin="0,18,0,4" />
    <TextBlock Text="{x:Static local:Strings.ZoomWhat}" Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,0,0,8" />
    <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
      <StackPanel x:Name="ZoomSteps" Orientation="Horizontal" />
    </Border>

    <!-- The notices (D-375, D-377): a switch per kind with the mark the notice itself shows, and the
         sound in a frame of its own under them, as it belongs to the questions only (D-395, D-396). -->
    <TextBlock Text="{x:Static local:Strings.NotifyLabel}" Style="{StaticResource SectionLabel}" Margin="0,22,0,4" />
    <TextBlock Text="{x:Static local:Strings.NotifyWhat}" Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,0,0,8" />
    <Border Style="{StaticResource Rows}">
      <StackPanel x:Name="NoticeRows" />
    </Border>
    <Border Style="{StaticResource Rows}" Margin="0,8,0,0">
      <StackPanel x:Name="SoundRow" />
    </Border>

    <!-- The title of the row says what it is; a label over it would say the same again. -->
    <Border Style="{StaticResource Rows}" Margin="0,22,0,0">
      <Grid Margin="12,10,12,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="{x:Static local:Strings.VoiceToggle}" Style="{StaticResource RowName}" />
          <TextBlock Text="{x:Static local:Strings.VoiceToggleWhat}" Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
        <ToggleButton x:Name="VoiceOn" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                      Checked="OnVoiceChanged" Unchecked="OnVoiceChanged" />
      </Grid>
    </Border>

    <!-- The language Whisper hears, apart from the language of the interface (D-326). -->
    <TextBlock Text="{x:Static local:Strings.VoiceLanguageLabel}" Style="{StaticResource SectionLabel}" Margin="0,22,0,4" />
    <TextBlock Text="{x:Static local:Strings.VoiceLanguageWhat}" Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,0,0,8" />
    <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="SpeechSystem" Style="{StaticResource Segment}" GroupName="VoiceLanguage" Checked="OnSpeechChanged"
                     Content="{x:Static local:Strings.LanguageSystem}" />
        <RadioButton x:Name="SpeechRussian" Style="{StaticResource Segment}" GroupName="VoiceLanguage" Checked="OnSpeechChanged"
                     Content="{x:Static local:Strings.LanguageRussian}" />
        <RadioButton x:Name="SpeechEnglish" Style="{StaticResource Segment}" GroupName="VoiceLanguage" Checked="OnSpeechChanged"
                     Content="{x:Static local:Strings.LanguageEnglish}" />
      </StackPanel>
    </Border>

    <TextBlock Text="{x:Static local:Strings.VoiceEngineLabel}" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />

    <RadioButton x:Name="Local" Style="{StaticResource Dot}" GroupName="VoiceEngine" Checked="OnEngineChanged">
      <StackPanel>
        <TextBlock Text="{x:Static local:Strings.VoiceLocalTitle}" FontWeight="Medium" />
        <TextBlock Text="{x:Static local:Strings.VoiceLocalWhat}" Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </RadioButton>

    <!-- The model: what it is now and the one thing to do with it. -->
    <StackPanel Margin="24,10,0,0">
      <Border x:Name="Track" Height="4" CornerRadius="2" Background="{StaticResource Raised}" Visibility="Collapsed">
        <Border x:Name="TrackFill" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource Ink}" Width="0" />
      </Border>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="ModelLine" Style="{StaticResource RowHint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button x:Name="ModelAction" Grid.Column="1" Style="{StaticResource SmallButton}" Click="OnModelAction" />
      </Grid>
    </StackPanel>

    <RadioButton x:Name="Cloud" Style="{StaticResource Dot}" GroupName="VoiceEngine" Margin="0,18,0,0" Checked="OnEngineChanged">
      <StackPanel>
        <TextBlock Text="{x:Static local:Strings.VoiceCloudTitle}" FontWeight="Medium" />
        <TextBlock Text="{x:Static local:Strings.VoiceCloudWhat}" Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </RadioButton>

    <StackPanel x:Name="KeyPanel" Margin="24,12,0,0" Visibility="Collapsed">
      <Border BorderBrush="{StaticResource Caution}" BorderThickness="2,0,0,0" Padding="10,0,0,0">
        <TextBlock Text="{x:Static local:Strings.VoiceHonest}" Style="{StaticResource RowHint}" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
      </Border>
      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Static local:Strings.VoiceKeyLabel}" Style="{StaticResource RowHint}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <Border Grid.Column="1" CornerRadius="8" Background="{StaticResource Raised}" BorderBrush="{StaticResource Hairline}"
                BorderThickness="1" Padding="8,5">
          <Grid>
            <PasswordBox x:Name="KeyBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}"
                         CaretBrush="{StaticResource Ink}" FontFamily="{StaticResource Mono}" FontSize="{StaticResource TextTiny}"
                         KeyDown="OnKeyBoxKey" />
            <TextBlock x:Name="KeyMask" FontFamily="{StaticResource Mono}" FontSize="{StaticResource TextTiny}"
                       Foreground="{StaticResource Ink}" VerticalAlignment="Center" Visibility="Collapsed" />
          </Grid>
        </Border>
        <Button x:Name="KeyAction" Grid.Column="2" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="OnKeyAction" />
      </Grid>
      <TextBlock x:Name="KeyProblem" Style="{StaticResource RowHint}" Foreground="{StaticResource Destructive}"
                 TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
      <TextBlock Text="{x:Static local:Strings.VoiceKeyWhere}" Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel>
  </StackPanel>
</UserControl>
