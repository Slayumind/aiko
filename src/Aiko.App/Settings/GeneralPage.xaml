<UserControl x:Class="Aiko.App.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aiko.App">

  <!-- Everything that is not about one environment: where Aiko lives, startup, language, access. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Theme/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Text="{x:Static local:Strings.NavGeneral}" FontFamily="{StaticResource Sans}" FontSize="16"
               FontWeight="Medium" Foreground="{StaticResource Ink}" />

    <TextBlock Text="{x:Static local:Strings.SectionWhereToShow}" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
    <Grid MaxWidth="360" HorizontalAlignment="Left">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="170" />
      </Grid.ColumnDefinitions>

      <RadioButton x:Name="PlaceTray" Grid.Column="0" Style="{StaticResource PlaceCard}"
                   GroupName="Place" Checked="OnPlaceChanged">
        <StackPanel>
          <!-- A screen with a dot down by the clock. -->
          <Border Height="46" CornerRadius="4" Background="{StaticResource Background}"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="1">
            <Grid VerticalAlignment="Bottom">
              <Border Height="8" Background="{StaticResource Raised}" />
              <Ellipse Width="5" Height="5" Fill="{StaticResource Positive}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
            </Grid>
          </Border>
          <TextBlock Text="{x:Static local:Strings.PlaceTray}" Style="{StaticResource RowName}" Margin="0,8,0,0"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </RadioButton>

      <RadioButton x:Name="PlaceIsland" Grid.Column="2" Style="{StaticResource PlaceCard}"
                   GroupName="Place" Checked="OnPlaceChanged">
        <StackPanel>
          <!-- The same screen with a small island at the top. -->
          <Border Height="46" CornerRadius="4" Background="{StaticResource Background}"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="1">
            <Border Width="38" Height="9" CornerRadius="0,0,5,5" Background="{StaticResource Raised}"
                    HorizontalAlignment="Center" VerticalAlignment="Top" />
          </Border>
          <TextBlock Text="{x:Static local:Strings.PlaceIsland}" Style="{StaticResource RowName}" Margin="0,8,0,0"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </RadioButton>
    </Grid>

    <!-- Only worth showing when Aiko lives in the island; in the tray it changes nothing. -->
    <local:RevealPanel x:Name="IslandOnly">
      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Static local:Strings.HideIslandInFullScreen}" Style="{StaticResource RowName}"
                   TextWrapping="Wrap" Margin="0,0,12,0" />
        <ToggleButton x:Name="HideInFullScreen" Grid.Column="1" Style="{StaticResource Switch}"
                      Checked="OnHideChanged" Unchecked="OnHideChanged" />
      </Grid>
    </local:RevealPanel>

    <TextBlock Text="{x:Static local:Strings.SectionStartupAndUpdates}" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Static local:Strings.StartWithWindows}" Style="{StaticResource RowName}" Margin="0,0,12,0" />
      <ToggleButton x:Name="RunAtStartup" Grid.Column="1" Style="{StaticResource Switch}"
                    Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
    </Grid>
    <!-- The switch itself lives on the privacy page: it is a consent, not a preference. The
         button stays here, because pressing it is the person's own action (D-113). -->

    <WrapPanel Margin="0,10,0,0">
      <Button x:Name="CheckNow" Content="{x:Static local:Strings.CheckNow}" Style="{StaticResource SmallButton}"
              Click="OnCheckNow" Margin="0,0,8,0" />
      <Button x:Name="OpenDownload" Content="{x:Static local:Strings.OpenDownloadPage}" Style="{StaticResource SmallButton}"
              Click="OnOpenDownload" Visibility="Collapsed" Margin="0,0,10,0" />
      <!-- Empty until something has been checked: an empty line would only leave a gap. -->
      <TextBlock x:Name="UpdateLine" Style="{StaticResource RowHint}" VerticalAlignment="Center" Visibility="Collapsed"
                 local:Motion.Appear="True" />
    </WrapPanel>
    <TextBlock Text="{x:Static local:Strings.PrivacyLinkFromGeneral}" Style="{StaticResource RowHint}" Margin="0,8,56,0" />

    <TextBlock Text="{x:Static local:Strings.SectionLanguage}" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
    <local:DropDown x:Name="LanguageChoiceDrop" Width="220" HorizontalAlignment="Left" />

    <TextBlock Text="{x:Static local:Strings.SectionAccess}" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="AccessLine" Style="{StaticResource RowHint}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button x:Name="AccessButton" Grid.Column="1" Content="{x:Static local:Strings.AccessCheck}"
              Style="{StaticResource SmallButton}" Click="OnCheckAccess" />
    </Grid>

    <TextBlock Text="{x:Static local:Strings.SectionDiagnostics}" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="DiagnosticsLine" Text="{x:Static local:Strings.DiagnosticsWhat}" Style="{StaticResource RowHint}"
                 VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button Grid.Column="1" Content="{x:Static local:Strings.CopyDiagnostics}" Style="{StaticResource SmallButton}"
              Click="OnCopyDiagnostics" />
    </Grid>

    <Border Height="1" Background="{StaticResource Hairline}" Margin="0,22,0,14" />

    <!-- Starting over takes a lot away, so it asks a second time and says what goes. -->
    <Grid x:Name="RestartRow">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Static local:Strings.RestartWhat}" Style="{StaticResource RowHint}" VerticalAlignment="Center"
                 Margin="0,0,12,0" />
      <Button Grid.Column="1" Content="{x:Static local:Strings.Restart}" Style="{StaticResource GhostDangerButton}"
              Margin="0,0,-10,0" Click="OnRestartAsked" />
    </Grid>
    <local:RevealPanel x:Name="RestartConfirm">
      <Border CornerRadius="10" Background="#0FFF6467" BorderBrush="#38FF6467" BorderThickness="1" Padding="12">
        <StackPanel>
          <TextBlock x:Name="RestartLine" Style="{StaticResource RowHint}" Foreground="{StaticResource Ink}" />
          <CheckBox x:Name="RestartBin" Style="{StaticResource Tick}" Margin="0,12,0,0">
            <TextBlock x:Name="RestartBinText" TextWrapping="Wrap" />
          </CheckBox>
          <TextBlock Text="{x:Static local:Strings.RestartKeep}" Style="{StaticResource RowHint}" Margin="0,8,0,0" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static local:Strings.Cancel}" Style="{StaticResource GhostButton}" Click="OnRestartCancelled" />
            <Button Content="{x:Static local:Strings.Restart}" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                    Click="OnRestartConfirmed" />
          </StackPanel>
        </StackPanel>
      </Border>
    </local:RevealPanel>

    <Button Content="{x:Static local:Strings.QuitAiko}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
            Margin="0,14,-10,0" Click="OnQuit" />
  </StackPanel>
</UserControl>
