<UserControl x:Class="Aiko.App.PrivacyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aiko.App">

  <!-- What leaves the computer, and the two switches that decide it. The list of fields is shown
       whether or not the count is on: somebody has to see what they are agreeing to before they
       agree, not after. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Theme/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Text="{x:Static local:Strings.NavPrivacy}" FontFamily="{StaticResource Sans}" FontSize="16"
               FontWeight="Medium" Foreground="{StaticResource Ink}" />

    <TextBlock Text="{x:Static local:Strings.SectionConnection}" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Static local:Strings.CheckUpdatesToggle}" Style="{StaticResource RowName}" Margin="0,0,12,0" />
      <ToggleButton x:Name="CheckUpdates" Grid.Column="1" Style="{StaticResource Switch}"
                    Checked="OnUpdatesChanged" Unchecked="OnUpdatesChanged" />
    </Grid>
    <TextBlock Text="{x:Static local:Strings.CheckUpdatesWhat}" Style="{StaticResource RowHint}"
               TextWrapping="Wrap" Margin="0,6,56,0" />

    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Static local:Strings.SendStatsToggle}" Style="{StaticResource RowName}"
                 TextWrapping="Wrap" Margin="0,0,12,0" />
      <ToggleButton x:Name="SendStats" Grid.Column="1" Style="{StaticResource Switch}"
                    Checked="OnStatsChanged" Unchecked="OnStatsChanged" />
    </Grid>
    <TextBlock Text="{x:Static local:Strings.SendStatsWhat}" Style="{StaticResource RowHint}"
               TextWrapping="Wrap" Margin="0,6,56,0" />

    <TextBlock Text="{x:Static local:Strings.SectionWhatIsSent}" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />

    <!-- Dimmed while nothing is sent, so the page reads as a list of what would go, not of what
         goes. -->
    <Border x:Name="Ledger" CornerRadius="10" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="42" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="v" Style="{StaticResource LedgerKey}" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static local:Strings.SentVersion}" Style="{StaticResource RowHint}" TextWrapping="Wrap" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="os" Style="{StaticResource LedgerKey}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static local:Strings.SentWindows}" Style="{StaticResource RowHint}" TextWrapping="Wrap" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="day" Style="{StaticResource LedgerKey}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Static local:Strings.SentDayId}" Style="{StaticResource RowHint}" TextWrapping="Wrap" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="w" Style="{StaticResource LedgerKey}" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Static local:Strings.SentWeekFlag}" Style="{StaticResource RowHint}" TextWrapping="Wrap" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="m" Style="{StaticResource LedgerKey}" />
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Static local:Strings.SentMonthFlag}" Style="{StaticResource RowHint}" TextWrapping="Wrap" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="p" Style="{StaticResource LedgerKey}" />
        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Static local:Strings.SentPersona}" Style="{StaticResource RowHint}" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <TextBlock x:Name="NothingSent" Text="{x:Static local:Strings.NothingSentYet}" Style="{StaticResource RowHint}"
               Margin="0,8,0,0" />

    <TextBlock Text="{x:Static local:Strings.SectionNeverSent}" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
    <TextBlock Text="{x:Static local:Strings.NeverSentWhat}" Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,0,56,0" />
    <TextBlock Text="{x:Static local:Strings.StatsKeptFor}" Style="{StaticResource RowHint}" Margin="0,8,0,0" />

    <WrapPanel Margin="0,22,0,0">
      <Button x:Name="ResetId" Content="{x:Static local:Strings.ResetInstallId}" Style="{StaticResource SmallButton}"
              Click="OnResetId" Margin="0,0,8,0" />
      <Button Content="{x:Static local:Strings.OpenPrivacyDoc}" Style="{StaticResource SmallButton}"
              Click="OnOpenPrivacyDoc" Margin="0,0,10,0" />
      <TextBlock x:Name="ResetLine" Text="{x:Static local:Strings.ResetInstallIdDone}" Style="{StaticResource RowHint}"
                 VerticalAlignment="Center" Visibility="Collapsed" local:Motion.Appear="True" />
    </WrapPanel>
    <TextBlock Text="{x:Static local:Strings.ResetInstallIdWhat}" Style="{StaticResource RowHint}"
               TextWrapping="Wrap" Margin="0,8,56,0" />
  </StackPanel>
</UserControl>
