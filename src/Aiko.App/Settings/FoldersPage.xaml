<UserControl x:Class="Aiko.App.FoldersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aiko.App">

  <!--
    Every bound folder in one table, folder on the left and its environment on the right (D-178).
    The last row is every other folder, and the environment picked there is the default. A list
    under a folder used to read as that folder's environment; in a table row it cannot.
  -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Theme/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Text="{x:Static local:Strings.ItemFolders}" FontFamily="{StaticResource Sans}" FontSize="16"
               FontWeight="Medium" Foreground="{StaticResource Ink}" />
    <TextBlock x:Name="Lead" Style="{StaticResource RowHint}" Margin="0,10,0,0" />

    <StackPanel x:Name="OneEnvironment" Margin="0,16,0,0">
      <TextBlock x:Name="OneEnvironmentText" Style="{StaticResource RowHint}" Foreground="{StaticResource Ink}" />
      <Button Content="{x:Static local:Strings.AddSecondEnvironment}" Style="{StaticResource SmallButton}" Margin="0,10,0,0"
              Click="OnSetUpEnvironments" />
    </StackPanel>

    <StackPanel x:Name="Table" Margin="0,16,0,0">
      <Border x:Name="NeedCommands" CornerRadius="10" Background="#0DFE9A00" BorderBrush="#38FE9A00" BorderThickness="1"
              Padding="12,10" Margin="0,0,0,12">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{x:Static local:Strings.SetUpEnvironments}" Style="{StaticResource SmallButton}"
                  VerticalAlignment="Center" Margin="12,0,0,0" Click="OnSetUpEnvironments" />
          <TextBlock Text="{x:Static local:Strings.FoldersNeedCommands}" Style="{StaticResource RowHint}"
                     Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Border CornerRadius="10" BorderBrush="{StaticResource Hairline}" BorderThickness="1">
        <StackPanel>
          <Grid Margin="12,8,8,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="176" />
              <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static local:Strings.FolderColumn}" Style="{StaticResource RowNote}" />
            <TextBlock Grid.Column="1" Text="{x:Static local:Strings.EnvironmentColumn}" Style="{StaticResource RowNote}"
                       Margin="10,0,0,0" />
          </Grid>

          <StackPanel x:Name="Rows" />

          <Border Background="#06FFFFFF" CornerRadius="0,0,9,9" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0">
            <Grid Margin="12,8,8,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="36" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static local:Strings.AllOtherFolders}" Style="{StaticResource RowName}" />
              <local:DropDown x:Name="RestChoice" Grid.Column="1" Margin="10,0,0,0" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Button Style="{StaticResource SmallButton}" Margin="0,12,0,0" Click="OnAddFolder">
        <StackPanel Orientation="Horizontal">
          <Path Data="M 5,0 L 5,10 M 0,5 L 10,5" Stroke="{StaticResource Ink}" StrokeThickness="1.5" Width="10" Height="10"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,7,0" />
          <TextBlock Text="{x:Static local:Strings.AddFolder}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>
  </StackPanel>
</UserControl>
