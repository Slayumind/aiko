<Project Sdk="Microsoft.NET.Sdk">

  <!--
    x64 is required: CsWin32 does not generate Shell_NotifyIcon and NOTIFYICONDATAW for AnyCPU,
    because their layout differs between x86 and x64 (spike 2026-09-11).

    There is no App.xaml: Aiko lives in the tray, so it has its own Main that creates the tray
    icon and only opens windows on demand.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Aiko.App.Program</StartupObject>
    <!-- The ring, drawn by tools/app-icon.ps1. Windows shows it in the Start menu and on Aiko's windows. -->
    <ApplicationIcon>Assets\aiko.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Geist and Geist Mono ship inside the app. The site loads them from Google Fonts, but a tray
    app has no browser, and without the files WPF quietly falls back to another face and the card
    changes width. OFL.txt is the licence and has to travel with them.
  -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Content Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Aiko's skills ship next to the app and are copied into the local marketplace from there. -->
    <Content Include="..\..\plugins\**\*" Exclude="..\..\plugins\**\__pycache__\**" Link="plugins\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    whisper.cpp for voice input (D-314): its dlls and the VAD model go to a whisper folder next to
    the app. They are fetched, checked by SHA256, into artifacts/whisper by tools/fetch-whisper.ps1
    the first time the app is built; they are not in git.
  -->
  <PropertyGroup>
    <WhisperFolder>$(MSBuildThisFileDirectory)..\..\artifacts\whisper\</WhisperFolder>
  </PropertyGroup>
  <Target Name="FetchWhisper" BeforeTargets="BeforeBuild" Condition="!Exists('$(WhisperFolder)whisper.dll')">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\..\tools\fetch-whisper.ps1&quot;" />
    <!-- Inside a target %(Filename) would batch over every Content item, so a type of its own. -->
    <ItemGroup>
      <FetchedWhisper Include="$(WhisperFolder)*" />
      <Content Include="@(FetchedWhisper)" Link="whisper\%(FetchedWhisper.Filename)%(FetchedWhisper.Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Content Include="$(WhisperFolder)*" Link="whisper\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- MIT asks for the licence to travel with the files. -->
    <Content Include="Assets\Licenses\*.txt" Exclude="Assets\Licenses\windows-terminal-LICENSE.txt" Link="whisper\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Licenses\windows-terminal-LICENSE.txt" Link="windows-terminal-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aiko.Core\Aiko.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Velopack" />
    <!-- The terminal control of Windows Terminal (D-360). Its native renderer comes with it. -->
    <PackageReference Include="CI.Microsoft.Terminal.Wpf" />
    <!--
      ConPTY newer than the one in Windows. Its own targets put OpenConsole.exe into an x64 folder
      while conpty.dll lands elsewhere; the spike ran both side by side, so they are copied here by hand.
    -->
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)\runtimes\win-x64\native\conpty.dll" Link="conpty.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\x64\OpenConsole.exe" Link="OpenConsole.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The words of the product, in one place per language. tools/strings.py makes both resource files
    and the class that reads them from tools/strings.json, so a key that does not exist is a build
    error. The class is generated into the source tree because WPF compiles XAML in a second pass,
    through a temporary project that cannot see files the first pass made.
  -->
  <ItemGroup>
    <EmbeddedResource Update="Strings.resx" />
    <EmbeddedResource Update="Strings.ru.resx" />
  </ItemGroup>

</Project>
