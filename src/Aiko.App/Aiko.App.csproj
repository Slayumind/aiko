<Project Sdk="Microsoft.NET.Sdk">

  <!--
    x64 is required: CsWin32 does not generate Shell_NotifyIcon and NOTIFYICONDATAW for AnyCPU,
    because their layout differs between x86 and x64 (spike 2026-09-11).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
