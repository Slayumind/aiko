<!--
  The few controls Aiko needs, in the shape the site uses: a switch, a segmented choice, a quiet
  button and a card you pick. Kept here so the settings window and the first run wizard cannot
  drift apart.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Theme/Tokens.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Group labels on the site are small, mono and in capitals. The capitals are typed in, since
       WPF has no text transform. -->
  <Style x:Key="SectionLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextTiny}" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="Margin" Value="0,16,0,6" />
  </Style>

  <Style x:Key="RowName" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Sans}" />
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="RowNote" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextTiny}" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- A sentence, not a number: mono is for figures and metadata. -->
  <Style x:Key="RowHint" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Sans}" />
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Switch" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Track" Width="32" Height="18" CornerRadius="9"
                  Background="{StaticResource InputLine}">
            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource Ink}"
                     HorizontalAlignment="Left" Margin="2,0,0,0" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource Positive}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One choice out of a few. The chosen one is lighter, not tinted: three greys of the same
       lightness are what the site uses for hover, and a tinted "on" would blend into it. -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource Sans}" />
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Back" CornerRadius="8" Background="Transparent" Padding="10,5">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{StaticResource InputLine}" />
              <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SegmentBar" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Raised}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- Where to show Aiko: a small picture of a screen beside each answer, so the choice is seen
       and not read. -->
  <Style x:Key="PlaceCard" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Back" CornerRadius="10" Padding="10" Background="Transparent"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="1">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{StaticResource Raised}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{StaticResource Raised}" />
              <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource InputLine}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NameBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Sans}" />
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Back" CornerRadius="8" Background="{StaticResource Raised}"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="8,5">
            <ScrollViewer x:Name="PART_ContentHost" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource InputLine}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The exact text Aiko is about to write into someone else's file. Shown, not described. -->
  <Style x:Key="CodeBlock" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextTiny}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border CornerRadius="8" Background="{StaticResource Background}"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="10,8">
            <ScrollViewer x:Name="PART_ContentHost" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="QuietButton" TargetType="Button">
    <Setter Property="Height" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource Sans}" />
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Back" CornerRadius="10" Background="{StaticResource Raised}" Padding="12,0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{StaticResource InputLine}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
