<!--
  The few controls Aiko needs, in the shape the site uses: a switch, a segmented choice, a quiet
  button and a card you pick. Kept here so the settings window and the first run wizard cannot
  drift apart.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Aiko.App"
                    xmlns:core="clr-namespace:Aiko.Core;assembly=Aiko.Core">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Aiko.App;component/Theme/Tokens.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Group labels on the site are small, mono and in capitals. The capitals are typed in, since
       WPF has no text transform. -->
  <Style x:Key="SectionLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextTiny}" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="Margin" Value="0,16,0,6" />
  </Style>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextTitle}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>

  <Style x:Key="RowName" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="RowNote" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextTiny}" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- The name of a field in the privacy ledger: it is a literal piece of the request, so it is
       mono and coloured like a value, not like a label. -->
  <Style x:Key="LedgerKey" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextTiny}" />
    <Setter Property="Foreground" Value="{StaticResource Positive}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- A sentence, not a number: mono is for figures and metadata. -->
  <Style x:Key="RowHint" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Both values stand in a row and the chosen one is in brackets: Off [On] (D-438). The brackets
       of the other value keep their place, so nothing moves when it flips. -->
  <Style x:Key="Switch" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="local:Motion.Press" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <TextBlock x:Name="Off" FontFamily="{StaticResource Mono}" FontSize="{StaticResource TextBody}"
                       FontWeight="Medium" Foreground="{StaticResource Ink}" Margin="0,3,8,3">
              <Run x:Name="OffOpen" Text="[" /><Run Text="{x:Static core:Strings.SwitchOff}" /><Run x:Name="OffClose" Text="]" />
            </TextBlock>
            <TextBlock x:Name="On" FontFamily="{StaticResource Mono}" FontSize="{StaticResource TextBody}"
                       Foreground="{StaticResource QuietText}" Margin="0,3,0,3">
              <Run x:Name="OnOpen" Text="[" Foreground="Transparent" /><Run Text="{x:Static core:Strings.SwitchOn}" /><Run x:Name="OnClose" Text="]" Foreground="Transparent" />
            </TextBlock>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="On" Property="Foreground" Value="{StaticResource Positive}" />
              <Setter TargetName="On" Property="FontWeight" Value="Medium" />
              <Setter TargetName="OnOpen" Property="Foreground" Value="{StaticResource Positive}" />
              <Setter TargetName="OnClose" Property="Foreground" Value="{StaticResource Positive}" />
              <Setter TargetName="Off" Property="Foreground" Value="{StaticResource QuietText}" />
              <Setter TargetName="Off" Property="FontWeight" Value="Normal" />
              <Setter TargetName="OffOpen" Property="Foreground" Value="Transparent" />
              <Setter TargetName="OffClose" Property="Foreground" Value="Transparent" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="On" Property="Foreground" Value="{StaticResource Ink}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Off" Property="Foreground" Value="{StaticResource Ink}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One choice out of a few. The chosen one is lighter, not tinted: three greys of the same
       lightness are what the site uses for hover, and a tinted "on" would blend into it. -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Back" Background="Transparent" />
            <Border x:Name="Hover" Background="{StaticResource HoverLayer}" Opacity="0" />
            <ContentPresenter Margin="10,5" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Ink}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{StaticResource Raised}" />
              <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Rows of settings in one frame, with a hairline between them: "Where Aiko is on", the notices. -->
  <Style x:Key="Rows" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style x:Key="SegmentBar" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- Where to show Aiko: a small picture of a screen beside each answer, so the choice is seen
       and not read. -->
  <Style x:Key="PlaceCard" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="local:Motion.Press" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <local:PixelBorder x:Name="Back" Background="Transparent"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1" />
            <Border x:Name="Hover" Background="{StaticResource HoverLayer}" Opacity="0" />
            <ContentPresenter Margin="11" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{StaticResource Raised}" />
              <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource Hairline}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NameBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <local:PixelBorder x:Name="Back" Background="Transparent"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="8,5">
            <ScrollViewer x:Name="PART_ContentHost" />
          </local:PixelBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource Muted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The exact text Aiko is about to write into someone else's file. Shown, not described. -->
  <Style x:Key="CodeBlock" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextTiny}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <local:PixelBorder Background="{StaticResource Background}"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="10,8">
            <ScrollViewer x:Name="PART_ContentHost" />
          </local:PixelBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="QuietButton" TargetType="Button">
    <Setter Property="Height" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="local:Motion.Press" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <local:PixelBorder BorderBrush="{StaticResource Hairline}" BorderThickness="1" />
            <Border x:Name="Hover" Background="{StaticResource HoverLayer}" Opacity="0" />
            <ContentPresenter Margin="12,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The small buttons of the settings window. One template for all of them: a thin line in the
    button's BorderBrush, no fill, and one light layer on hover. A ghost button has no line.
  -->
  <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
    <Grid>
      <local:PixelBorder Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" />
      <Border x:Name="Hover" Background="{StaticResource HoverLayer}" Opacity="0" />
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="SmallButton" TargetType="Button">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="local:Motion.Press" Value="True" />
    <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}" />
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="BorderThickness" Value="0" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
    <Setter Property="Foreground" Value="{StaticResource Destructive}" />
    <Setter Property="BorderBrush" Value="{StaticResource Destructive}" />
  </Style>

  <Style x:Key="GhostDangerButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
    <Setter Property="Foreground" Value="{StaticResource Destructive}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- The close cross in a window header. -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="local:Motion.Press" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Background="Transparent" />
            <Border x:Name="Hover" Background="{StaticResource Raised}" Opacity="0" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A tick box with its words beside it. The words are a TextBlock, so they can wrap. -->
  <Style x:Key="Tick" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top" local:Motion.Press="True">
              <local:PixelBorder BorderBrush="{StaticResource Hairline}" BorderThickness="1.5" />
              <Border x:Name="Fill" Background="{StaticResource Ink}" Opacity="0" />
              <Path x:Name="Mark" Data="M 4,8 L 7,11 L 12,5" Stroke="{StaticResource Background}" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0" />
            </Grid>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Fill" Property="Opacity" Value="1" />
              <Setter TargetName="Mark" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One of a few choices, the pair of Tick: a square with a smaller square inside when chosen. -->
  <Style x:Key="Dot" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top" local:Motion.Press="True">
              <local:PixelBorder BorderBrush="{StaticResource Hairline}" BorderThickness="1" />
              <Border x:Name="Chosen" Margin="4" Background="{StaticResource Ink}" Opacity="0" />
            </Grid>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Top" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chosen" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A plan name or a count: mono on a faint plate. -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource HoverLayer}" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="ChipText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextTiny}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>

  <!-- One item of a side menu: the chosen one sits on a lighter plate. -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="local:Motion.Press" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Back" Background="Transparent" />
            <Border x:Name="Hover" Background="{StaticResource HoverLayer}" Opacity="0" />
            <ContentPresenter Margin="10,7" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Ink}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{StaticResource Raised}" />
              <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    A right-click menu looks like the list of a drop-down (DropDown): the dark ground, one line,
    padding 4 and the shadow of a card, rows of 30. The margin keeps room for the
    shadow inside the popup. Both styles have no key, so they reach every menu of a window that
    merges this file, the menu of a text field too.
  -->
  <Style TargetType="ContextMenu">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <!-- The zoom of the window the menu opens over (PopupZoom). -->
    <Setter Property="LayoutTransform" Value="{Binding PlacementTarget, RelativeSource={RelativeSource Self}, Converter={x:Static local:PopupZoom.Converter}}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <local:PixelBorder Margin="0,0,12,12" MinWidth="180" Padding="4"
                  Background="{StaticResource Background}" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                  Effect="{StaticResource CardShadow}">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </local:PixelBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Back" Height="30" Padding="10,0,10,0" Background="Transparent">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{StaticResource Raised}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Muted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A thin scroll bar that only shows when there is something to scroll. -->
  <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
    <Setter Property="Width" Value="6" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource Hairline}" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="QuietScroll" TargetType="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid>
            <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"
                                    Margin="{TemplateBinding Padding}" />
            <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource ThinScrollBar}"
                       HorizontalAlignment="Right" Margin="0,8,3,8"
                       Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
