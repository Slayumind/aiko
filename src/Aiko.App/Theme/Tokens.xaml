<!--
  The slayumind palette, put into WPF. Values come from docs/DESIGN.md, which reads them from the
  site itself. Nothing here invents a colour: eight colours, plus a few see through whites for
  hairlines. Dark only.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <Color x:Key="BackgroundColor">#FF0A0A0A</Color>
  <Color x:Key="SurfaceColor">#FF171717</Color>
  <Color x:Key="RaisedColor">#FF262626</Color>
  <Color x:Key="MutedColor">#FFA1A1A1</Color>
  <Color x:Key="InkColor">#FFFAFAFA</Color>
  <Color x:Key="PositiveColor">#FF00BC7D</Color>
  <Color x:Key="CautionColor">#FFFE9A00</Color>
  <Color x:Key="DestructiveColor">#FFFF6467</Color>

  <SolidColorBrush x:Key="Background" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
  <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="Positive" Color="{StaticResource PositiveColor}" />
  <SolidColorBrush x:Key="Caution" Color="{StaticResource CautionColor}" />
  <SolidColorBrush x:Key="Destructive" Color="{StaticResource DestructiveColor}" />

  <!-- Hairlines are white at low opacity, not a grey of their own: they have to sit on both the
       card and the raised surface without becoming a line of their own colour. -->
  <Color x:Key="HairlineColor">#1AFFFFFF</Color>
  <Color x:Key="InputLineColor">#26FFFFFF</Color>
  <SolidColorBrush x:Key="Hairline" Color="{StaticResource HairlineColor}" />
  <SolidColorBrush x:Key="InputLine" Color="{StaticResource InputLineColor}" />

  <!-- Hover lightens whatever is under it by this much, as a layer that fades in. -->
  <SolidColorBrush x:Key="HoverLayer" Color="#12FFFFFF" />

  <FontFamily x:Key="Sans">pack://application:,,,/Assets/Fonts/#Geist</FontFamily>
  <FontFamily x:Key="Mono">pack://application:,,,/Assets/Fonts/#Geist Mono</FontFamily>

  <sys:Double x:Key="TextTiny">11</sys:Double>
  <sys:Double x:Key="TextSmall">12</sys:Double>
  <sys:Double x:Key="TextNumber">13</sys:Double>
  <sys:Double x:Key="TextName">14</sys:Double>

  <!-- One material for the icon, the card, the island and the windows. -->
  <CornerRadius x:Key="CardRadius">14</CornerRadius>
  <CornerRadius x:Key="BarRadius">2</CornerRadius>
  <sys:Double x:Key="CardWidth">296</sys:Double>
  <sys:Double x:Key="CardPadding">14</sys:Double>
  <sys:Double x:Key="BarHeight">4</sys:Double>
  <sys:Double x:Key="Step">4</sys:Double>

  <Thickness x:Key="CardPad">14</Thickness>
  <Thickness x:Key="BlockGap">0,12,0,0</Thickness>
  <Thickness x:Key="RowGap">0,8,0,0</Thickness>
  <Thickness x:Key="UnderBar">0,3,0,0</Thickness>

  <!-- Only floating things get a shadow, and only this one. -->
  <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="8" Direction="270"
                    Color="#FF000000" Opacity="0.45" />

