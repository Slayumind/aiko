<!--
  The tip of every window: the island, the terminal window and the settings. It is merged into the
  application, not into one window, so a tip looks the same wherever it opens. The look is the one
  of the right-click menu: Surface, one line, radius 8, the small sans text. It takes the zoom of
  the window it opens over (PopupZoom).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Aiko.App">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Aiko.App;component/Theme/Tokens.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- The face of a tip. The tip snapshot of Aiko.Checks draws it too, where a real ToolTip cannot stand. -->
  <ControlTemplate x:Key="TipTemplate" TargetType="ContentControl">
    <Border Padding="8,4,8,5" CornerRadius="8" MaxWidth="320"
            Background="{StaticResource Surface}" BorderBrush="{StaticResource InputLine}" BorderThickness="1">
      <ContentPresenter TextElement.FontFamily="{StaticResource Sans}"
                        TextElement.FontSize="{StaticResource TextSmall}"
                        TextElement.Foreground="{StaticResource Ink}">
        <ContentPresenter.Resources>
          <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
          </Style>
        </ContentPresenter.Resources>
      </ContentPresenter>
    </Border>
  </ControlTemplate>

  <Style TargetType="ToolTip">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="LayoutTransform" Value="{Binding PlacementTarget, RelativeSource={RelativeSource Self}, Converter={x:Static local:PopupZoom.Converter}}" />
    <Setter Property="Template" Value="{StaticResource TipTemplate}" />
  </Style>

</ResourceDictionary>
