<UserControl x:Class="Aiko.App.WizardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aiko.App">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Theme/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate x:Key="FoundTemplate" DataType="{x:Type local:WizardEnvironment}">
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource NameBox}" />
            <TextBlock Text="{Binding FullPath}" Style="{StaticResource RowNote}" Margin="0,4,0,0" />
          </StackPanel>

          <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                        IsChecked="{Binding Use, Mode=TwoWay}" />
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Margin="20">
    <Border Width="380"
            Background="{StaticResource Surface}"
            CornerRadius="{StaticResource CardRadius}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="1"
            Effect="{StaticResource CardShadow}">
      <StackPanel Margin="{StaticResource CardPad}">

        <Grid x:Name="HeaderRow">
          <TextBlock x:Name="StepTitle" VerticalAlignment="Center"
                     FontFamily="{StaticResource Sans}" FontSize="{StaticResource TextName}"
                     FontWeight="Medium" Foreground="{StaticResource Ink}" />
          <TextBlock x:Name="StepCount" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Style="{StaticResource RowNote}" />
        </Grid>

        <!-- Step 1: the environments Aiko found. -->
        <StackPanel x:Name="StepEnvironments" Margin="0,14,0,0">
          <TextBlock x:Name="FoundIntro" Style="{StaticResource RowHint}" Margin="0,0,0,12" />
          <ItemsControl x:Name="Found" ItemTemplate="{StaticResource FoundTemplate}" />

          <StackPanel x:Name="NothingFound" Visibility="Collapsed">
            <TextBlock Style="{StaticResource RowHint}" Margin="0,0,0,10"
                       Text="{x:Static local:Strings.WizardNothingFound}" />
            <StackPanel Orientation="Horizontal">
              <Button Content="{x:Static local:Strings.WizardChooseFolder}" Style="{StaticResource QuietButton}" Click="OnChooseFolder" />
              <Button Content="{x:Static local:Strings.WizardCheckAgain}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="OnCheckAgain" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Step 2: the one line Aiko adds to the Claude Code settings. -->
        <StackPanel x:Name="StepAccess" Margin="0,14,0,0" Visibility="Collapsed">
          <TextBlock Style="{StaticResource RowHint}" Margin="0,0,0,10"
                     Text="{x:Static local:Strings.WizardAccessExplain}" />
          <TextBlock Text="{x:Static local:Strings.WizardTheLine}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
          <TextBox x:Name="LinePreview" Style="{StaticResource CodeBlock}" />
          <TextBlock Text="{x:Static local:Strings.WizardTheFiles}" Style="{StaticResource SectionLabel}" />
          <ItemsControl x:Name="FilesToChange">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Style="{StaticResource RowNote}" Margin="0,0,0,4" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource RowHint}" Margin="0,10,0,0"
                     Text="{x:Static local:Strings.WizardBackupNote}" />
          <TextBlock x:Name="AccessResult" Style="{StaticResource RowHint}" Margin="0,10,0,0"
                     Visibility="Collapsed" />
        </StackPanel>

        <!-- Step 3: where Aiko lives, and the two switches. -->
        <StackPanel x:Name="StepWhere" Margin="0,14,0,0" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <RadioButton x:Name="PlaceTray" Grid.Column="0" Style="{StaticResource PlaceCard}"
                         GroupName="Place" IsChecked="True">
              <StackPanel>
                <Border Height="46" CornerRadius="4" Background="{StaticResource Background}"
                        BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                  <Grid VerticalAlignment="Bottom">
                    <Border Height="8" Background="{StaticResource Raised}" />
                    <Ellipse Width="5" Height="5" Fill="{StaticResource Positive}"
                             HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                  </Grid>
                </Border>
                <TextBlock Text="{x:Static local:Strings.PlaceTray}" Style="{StaticResource RowName}" Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="PlaceIsland" Grid.Column="2" Style="{StaticResource PlaceCard}"
                         GroupName="Place">
              <StackPanel>
                <Border Height="46" CornerRadius="4" Background="{StaticResource Background}"
                        BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                  <Border Width="38" Height="9" CornerRadius="0,0,5,5" Background="{StaticResource Raised}"
                          HorizontalAlignment="Center" VerticalAlignment="Top" />
                </Border>
                <TextBlock Text="{x:Static local:Strings.PlaceIsland}" Style="{StaticResource RowName}" Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </RadioButton>
          </Grid>

          <!-- Text and switch in columns of their own: in Russian the text is longer and ran under the switch. -->
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static local:Strings.StartWithWindows}" Style="{StaticResource RowName}"
                       TextWrapping="Wrap" Margin="0,0,12,0" />
            <ToggleButton x:Name="RunAtStartup" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True" />
          </Grid>

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{x:Static local:Strings.CheckUpdatesToggle}" Style="{StaticResource RowName}" />
              <TextBlock Text="{x:Static local:Strings.WizardUpdatesWhat}" Style="{StaticResource RowNote}"
                         TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>
            <ToggleButton x:Name="CheckUpdates" Grid.Column="1" Style="{StaticResource Switch}"
                          VerticalAlignment="Center" />
          </Grid>
        </StackPanel>

        <!--
          The wizard used to end by closing itself, which left somebody looking at a taskbar with
          nothing new on it. Windows 11 puts the icon of a new app behind the overflow arrow, and
          under that arrow the card never opens at all, so Aiko would look broken from the first
          minute. This is the one thing everybody needs to be told, and it was only in the readme.
        -->
        <StackPanel x:Name="StepDone" Margin="0,14,0,0" Visibility="Collapsed">
          <TextBlock x:Name="DoneWhere" Style="{StaticResource RowName}" TextWrapping="Wrap" />
          <TextBlock x:Name="DoneOverflow" Style="{StaticResource RowHint}" Margin="0,8,0,0"
                     TextWrapping="Wrap"
                     Text="{x:Static local:Strings.WizardDoneOverflow}" />
          <TextBlock x:Name="DoneFirstNumbers" Style="{StaticResource RowHint}" Margin="0,8,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Border Height="1" Background="{StaticResource Hairline}" Margin="0,16,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BackButton" Content="{x:Static local:Strings.Back}" Style="{StaticResource QuietButton}"
                  Visibility="Collapsed" Margin="0,0,8,0" Click="OnBack" />
          <Button x:Name="SkipButton" Content="{x:Static local:Strings.NotNow}" Style="{StaticResource QuietButton}"
                  Visibility="Collapsed" Margin="0,0,8,0" Click="OnSkip" />
          <Button x:Name="NextButton" Content="{x:Static local:Strings.Next}" Style="{StaticResource QuietButton}" Click="OnNext" />
        </StackPanel>

      </StackPanel>
    </Border>
  </Grid>
</UserControl>
