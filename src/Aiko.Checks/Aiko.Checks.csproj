<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The checks and snapshots of Aiko (D-420): tools/check-shell.sh, /look and CONTRIBUTING run them.
    They reach the insides of Aiko.App through InternalsVisibleTo. The installer packs Aiko.App only,
    so none of this reaches a person.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>Aiko.Checks.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aiko.App\Aiko.App.csproj" />
    <ProjectReference Include="..\Aiko.Core\Aiko.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Aiko.Shared" />
  </ItemGroup>

</Project>
