    { "header": "Authorization", "from": "https://api.anthropic.com/api/oauth/usage", "to": "https://github.com/x", "keeps": false },
    { "header": "authorization", "from": "https://api.anthropic.com/a", "to": "https://slayumind.org/a", "keeps": false },
    { "header": "Authorization", "from": "https://api.anthropic.com/a", "to": "http://api.anthropic.com/a", "keeps": false },
    { "header": "Authorization", "from": "https://api.anthropic.com/a", "to": "https://api.anthropic.com:8443/a", "keeps": false },
    { "header": "Cookie", "from": "https://slayumind.org/a", "to": "https://github.com/a", "keeps": false },
    { "header": "Proxy-Authorization", "from": "https://slayumind.org/a", "to": "https://github.com/a", "keeps": false },
    { "header": "User-Agent", "from": "https://api.anthropic.com/a", "to": "https://github.com/a", "keeps": true },
    { "header": "anthropic-beta", "from": "https://api.anthropic.com/a", "to": "https://github.com/a", "keeps": true }
  ]
