{
  "comment": "The four permission modes of the terminal (D-302). The names are the words of Claude Code and are the same in every language of the interface. The stream calls the manual mode default, so the flag and a request both send default. The flag is always passed: without it a new config folder starts in auto mode. A new session starts in the default mode of the settings files, the strongest first (D-311).",
  "modes": [
    { "mode": "manual", "name": "manual", "flag": "default", "request": "default", "next": "acceptEdits" },
    { "mode": "acceptEdits", "name": "acceptEdits", "flag": "acceptEdits", "request": "acceptEdits", "next": "plan" },
    { "mode": "plan", "name": "plan", "flag": "plan", "request": "plan", "next": "auto" },
    { "mode": "auto", "name": "auto", "flag": "auto", "request": "auto", "next": "manual" }
  ],
  "order": ["manual", "acceptEdits", "plan", "auto"],
  "fromStream": [
    { "value": "default", "mode": "manual" },
    { "value": "manual", "mode": "manual" },
    { "value": "acceptEdits", "mode": "acceptEdits" },
    { "value": "plan", "mode": "plan" },
    { "value": "auto", "mode": "auto" },
    { "value": "bypassPermissions", "mode": null },
    { "value": "dontAsk", "mode": null },
    { "value": "Plan", "mode": null },
    { "value": "accept_edits", "mode": null },
    { "value": " plan", "mode": null },
    { "value": "", "mode": null },
    { "value": null, "mode": null }
  ],
  "defaults": [
    { "name": "no settings at all", "settings": [null, null, null], "mode": "manual" },
    { "name": "the local settings of the project say auto", "settings": ["{\"permissions\":{\"defaultMode\":\"auto\",\"allow\":[]}}", "{\"permissions\":{\"defaultMode\":\"plan\"}}", null], "mode": "auto" },
    { "name": "the project says nothing, the config folder says acceptEdits", "settings": ["{\"permissions\":{\"allow\":[\"Read\"]}}", null, "{\"permissions\":{\"defaultMode\":\"acceptEdits\"}}"], "mode": "acceptEdits" },
    { "name": "default is the manual mode", "settings": ["{\"permissions\":{\"defaultMode\":\"default\"}}"], "mode": "manual" },
    { "name": "a mode the terminal does not offer decides as manual", "settings": ["{\"permissions\":{\"defaultMode\":\"bypassPermissions\"}}", "{\"permissions\":{\"defaultMode\":\"auto\"}}"], "mode": "manual" },
    { "name": "a broken file is skipped", "settings": ["{ not json", "{\"permissions\":{\"defaultMode\":\"plan\"}}"], "mode": "plan" },
    { "name": "a mode of another shape is skipped", "settings": ["{\"permissions\":{\"defaultMode\":3}}", "[1]", "{\"permissions\":\"auto\"}"], "mode": "manual" }
  ]
