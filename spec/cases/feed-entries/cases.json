{
  "comment": "The rows of the feed (D-342). feeds: items are steps (kind, subject, state; hidden when the step is not drawn) or any other item (\"other\"), with ids from 1 in order. rows: \"one\" is a single item by id; \"run\" is two or more read or search steps of one kind in a row, with the state of the run (failed over running over done), its first two names each once, and how many other names there are. outputs: an output of that many lines \"line 1\" … shows \"shown\" lines and hides the rest behind a button: only when it has more than 11.",
  "feeds": [
    {
      "name": "three reads in a row are one line",
      "items": [
        { "kind": "read", "subject": "TalkInput.cs", "state": "done" },
        { "kind": "read", "subject": "SlashMenuView.cs", "state": "done" },
        { "kind": "read", "subject": "TalkPanel.cs", "state": "running" }
      ],
      "rows": [{ "run": [1, 2, 3], "kind": "read", "state": "running", "names": ["TalkInput.cs", "SlashMenuView.cs"], "more": 1 }]
    },
    {
      "name": "one read stays a step",
      "items": [{ "other": "answer" }, { "kind": "read", "subject": "a.cs", "state": "done" }, { "other": "answer" }],
      "rows": [{ "one": 1 }, { "one": 2 }, { "one": 3 }]
    },
    {
      "name": "a file read twice is named once",
      "items": [
        { "kind": "read", "subject": "a.cs", "state": "done" },
        { "kind": "read", "subject": "a.cs", "state": "failed" }
      ],
      "rows": [{ "run": [1, 2], "kind": "read", "state": "failed", "names": ["a.cs"], "more": 0 }]
    },
    {
      "name": "a search after reads starts its own line, and an edit stays alone",
      "items": [
        { "kind": "read", "subject": "a.cs", "state": "done" },
        { "kind": "read", "subject": "b.cs", "state": "done" },
        { "kind": "search", "subject": "TODO", "state": "done" },
        { "kind": "search", "subject": "FIXME", "state": "done" },
        { "kind": "edit", "subject": "a.cs", "state": "done" },
        { "kind": "edit", "subject": "b.cs", "state": "done" }
      ],
      "rows": [
        { "run": [1, 2], "kind": "read", "state": "done", "names": ["a.cs", "b.cs"], "more": 0 },
        { "run": [3, 4], "kind": "search", "state": "done", "names": ["TODO", "FIXME"], "more": 0 },
        { "one": 5 },
        { "one": 6 }
      ]
    },
    {
      "name": "a step that is not drawn ends a run",
      "items": [
        { "kind": "read", "subject": "a.cs", "state": "done" },
        { "kind": "read", "subject": "b.cs", "state": "done", "hidden": true },
        { "kind": "read", "subject": "c.cs", "state": "done" }
      ],
      "rows": [{ "one": 1 }, { "one": 2 }, { "one": 3 }]
    }
  ],
  "outputs": [
    { "lines": 3, "shown": 3, "hidden": 0 },
    { "lines": 11, "shown": 11, "hidden": 0 },
    { "lines": 12, "shown": 10, "hidden": 2 },
    { "lines": 24, "shown": 10, "hidden": 14 }
  ]
}
