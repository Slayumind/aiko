          "key": "up",
          "field": "three",
          "taken": true
        },
        {
          "key": "up",
          "field": "two",
          "taken": true
        },
        {
          "key": "up",
          "field": "one",
          "taken": true
        },
        {
          "key": "up",
          "field": "one",
          "taken": true
        }
      ]
    },
    {
      "name": "down past the newest gives back what was typed",
      "sent": [
        "one",
        "two"
      ],
      "field": "half typed",
      "steps": [
        {
          "key": "up",
          "field": "two",
          "taken": true
        },
        {
          "key": "up",
          "field": "one",
          "taken": true
        },
        {
          "key": "down",
          "field": "two",
          "taken": true
