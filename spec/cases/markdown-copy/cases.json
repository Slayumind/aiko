    { "name": "inside a bold word", "markdown": "Plain **bold** and `code`.", "from": [1, 1], "to": [1, 3], "copied": "**ol**" },
    { "name": "across marks", "markdown": "Plain **bold** and `code`.", "from": [0, 2], "to": [3, 2], "copied": "ain **bold** and `co`" },
