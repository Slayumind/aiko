    { "name": "nothing selected", "markdown": "Hello", "from": [0, 2], "to": [0, 2], "copied": "" },
    { "name": "part of a heading keeps no #", "markdown": "## Title here", "from": [0, 0], "to": [0, 5], "copied": "Title" },
    { "name": "a heading and a paragraph", "markdown": "## Title\n\nBody text.", "from": [0, 0], "to": [1, 4], "copied": "## Title\n\nBody" },
